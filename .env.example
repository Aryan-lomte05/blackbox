# Copy to .env and fill in. Never commit .env (CLAUDE.md hard rule 7).

# Several Groq keys, comma-separated, rotated automatically on rate limits (one per teammate)
GROQ_API_KEYS=
OPENROUTER_API_KEY=
# Ollama needs no key; change only if Ollama runs on another port/machine
OLLAMA_BASE_URL=http://localhost:11434/v1

# Step checker cascade: Laya (local, no key) -> Jev (only if set) -> LLM
TYPESAFE_API_KEY=
# Verify re-asks a suspect step with this model (models.yaml id). Default: the local 7B; hosted: agent-strong-groq
BLACKBOX_VERIFY_MODEL=agent-local-7b
BLACKBOX_ALARM_THRESHOLD=0.35
BLACKBOX_CONFIDENCE_THRESHOLD=0.75
BLACKBOX_ESCALATE_THRESHOLD=0.60
BLACKBOX_MONITOR_LLM_MODEL=monitor-llm


# Guardian alert channels (docs/GUARDIAN_SETUP.md). Each channel is used only when its settings are set.
# Check with `blackbox guardian channels`; send a test with `blackbox guardian test`.
BLACKBOX_DASHBOARD_URL=http://localhost:8000
ALERT_OWNER_NAME=
# Email over EmailJS (default; template uses {{subject}}, {{to_email}}, {{{html_message}}})
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Email over SMTP instead (Gmail: smtp.gmail.com, port 587, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Email over Mailgun (alternative to SMTP)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# WhatsApp and phone calls over Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_WHATSAPP_TO=
# Phone calls are opt-in (critical incidents only)
BLACKBOX_VOICE_CALLS=0
TWILIO_VOICE_FROM=
ALERT_PHONE_TO=
# Slack incoming webhook
SLACK_WEBHOOK_URL=
# Telegram bot (token from @BotFather; chat id from `blackbox guardian telegram-chat-id`)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the DB, save-points and shards live (gitignored)
BLACKBOX_DATA=data
# Name this machine; it is written on every run so shards can be traced
BLACKBOX_MACHINE=

# MongoDB database connection (for user storage & session management)
MONGODB_URI=
# Google OAuth Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Session signing secret. Set a long random value anywhere sessions should survive a
# restart (e.g. `py -3 -c "import secrets; print(secrets.token_hex(32))"`). If empty,
# a random per-process secret is used.
SESSION_SECRET=
# 1 enables POST /api/auth/dev-login (sign in as any name/email, for local demos).
# Never set this on a shared or deployed server. Ignored when ENVIRONMENT=production.
BLACKBOX_DEV_LOGIN=

